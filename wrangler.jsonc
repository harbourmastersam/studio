{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "account_id": "7e75d1350b9d75dddd9d48946c5ae6da",
  "main": "worker.ts",
  "name": "outerbase-studio",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "studio.greyharbour.net",
      "custom_domain": true
    }
  ],
  // next-themes serializes an inline script; keep_names injects an unavailable __name helper.
  "keep_names": false,
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
