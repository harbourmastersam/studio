# Public, build-time configuration. Use the exact parent origin, without a slash.
# Replace with your Pelican origin before the production build.
NEXT_PUBLIC_EMBED_ALLOWED_ORIGIN=https://panel.example.com
# Development example (also requires a rebuild/restart):
# NEXT_PUBLIC_EMBED_ALLOWED_ORIGIN=http://localhost:3000
# No database passwords, API credentials or authentication tokens belong here.

# Public build-time exposure flag. Defaults to true for production builds and
# false for next dev. Set false only for a standalone local build, then rebuild.
# STUDIO_EMBED_ONLY=true
